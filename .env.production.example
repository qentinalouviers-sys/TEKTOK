# Production environment — copy to .env and fill in real values

# Required: Gemini AI API key
GEMINI_API_KEY=your_gemini_api_key_here

# Required: MiniMax TTS API key (for voiceover generation)
MINIMAX_API_KEY=

# Optional: Pexels API key (for B-roll video fallback)
PEXELS_API_KEY=

# Required: Public URL of the deployed app
APP_URL=https://tektok.eviatek.fr

# Required: Server port
PORT=3000

# Optional: YouTube cookies in Netscape format (for age-restricted / protected videos)
# If not set, yt-dlp will attempt unauthenticated download (works on dedicated IPs like OVH)
YOUTUBE_COOKIES=

# Optional: Path to a cookies.txt file on the server (alternative to YOUTUBE_COOKIES)
# YOUTUBE_COOKIES_PATH=/app/cookies.txt
